@inject AuthenticationStateProvider AuthProvider

<nav class="navbar">
    <a class="brand" href="/">
        <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
        Scrobblint
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
    </label>
    <div class="nav-links">
        <AuthorizeView>
            <Authorized>
                <NavLink href="/dashboard">Dashboard</NavLink>
                <NavLink href="/recent">Recent</NavLink>
                <NavLink href="/stats">Statistics</NavLink>
                <NavLink href="/settings">Settings</NavLink>
                <AuthorizeView Roles="Admin" Context="admin">
                    <NavLink href="/admin">Administration</NavLink>
                </AuthorizeView>
                <span class="nav-user">
                    <span class="nav-avatar" aria-hidden="true">@(char.ToUpperInvariant(context.User.Identity?.Name?.FirstOrDefault() ?? '?'))</span>
                    @context.User.Identity?.Name
                </span>
                <form method="post" action="/account/logout" class="inline-form">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-link">Log out</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink href="/login">Login</NavLink>
                <NavLink href="/register">Register</NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>
